PORT=3000
INSTANCE_ID=api-local
DATABASE_URL=postgresql://app:appsecret@localhost:5433/products_practice
REDIS_URL=redis://localhost:6380
LOG_LEVEL=info
PRODUCT_CACHE_TTL_SECONDS=60
NEGATIVE_CACHE_TTL_SECONDS=30

# Redis server (docker compose) — must match CACHE_EVICTION_POLICY_TARGET when verifying.
# allkeys-lru: Redis is cache-only; evict least-recently-used keys when over maxmemory (rebuild from Postgres).
REDIS_MAXMEMORY=64mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Same string as REDIS_MAXMEMORY_POLICY (evaluator compares CONFIG GET maxmemory-policy).
CACHE_EVICTION_POLICY_TARGET=allkeys-lru

# Cache warming — comma-separated product ids; optional startup warm via CACHE_WARM_ON_STARTUP=1
CACHE_WARM_ON_STARTUP=0
CACHE_WARM_PRODUCT_IDS=
