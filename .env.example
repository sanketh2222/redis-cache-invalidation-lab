PORT=3000
INSTANCE_ID=api-local
DATABASE_URL=postgresql://app:appsecret@localhost:5433/products_practice
REDIS_URL=redis://localhost:6380
LOG_LEVEL=info
PRODUCT_CACHE_TTL_SECONDS=60
NEGATIVE_CACHE_TTL_SECONDS=30

# Redis server (docker compose) — choose policy for your workload; must match CACHE_EVICTION_POLICY_TARGET when verifying.
REDIS_MAXMEMORY=64mb
REDIS_MAXMEMORY_POLICY=noeviction

# After you choose an eviction policy, set the same value here so npm run evaluate can verify config alignment.
CACHE_EVICTION_POLICY_TARGET=

# Cache warming — comma-separated product ids; optional startup warm via CACHE_WARM_ON_STARTUP=1
CACHE_WARM_ON_STARTUP=0
CACHE_WARM_PRODUCT_IDS=
