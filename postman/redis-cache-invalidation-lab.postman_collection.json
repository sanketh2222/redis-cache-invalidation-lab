{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Redis Cache Invalidation Lab API",
    "description": "Product catalog API with Redis caching (**redis-cache-invalidation-lab**).\n\n**Default:** `baseUrl` = http://localhost:3000\n\nStart this lab with `npm run dev` before sending requests. Port 3000 must be this API. If another app (for example a React dev server) is already on 3000, Postman will get that app's HTML (`Cannot GET /health`) instead of JSON.\n\n**Dual instances:** set `baseUrl` to http://localhost:3001 or http://localhost:8080.\n\n`GET /metrics` returns Prometheus text, not JSON. Other routes return JSON.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "category",
      "value": "electronics",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & Metrics",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Liveness check. Returns `{ ok, instance }`."
          },
          "response": []
        },
        {
          "name": "Metrics (Prometheus)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/metrics",
            "description": "Prometheus text exposition, not JSON."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products",
            "description": "Full product list."
          },
          "response": []
        },
        {
          "name": "List products by category",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products?category={{category}}",
            "description": "Category filter. Seed categories: electronics, home, stationery."
          },
          "response": []
        },
        {
          "name": "Get product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}",
            "description": "Product detail."
          },
          "response": []
        },
        {
          "name": "Get product (missing ID)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/99999",
            "description": "404 for unknown id."
          },
          "response": []
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"USB-C Hub\",\n  \"description\": \"4-port hub for practice\",\n  \"price\": 34.99,\n  \"category\": \"electronics\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/products",
            "description": "Requires name, price, and category. Returns 201."
          },
          "response": []
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse (updated)\",\n  \"price\": 31.99\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/products/{{productId}}",
            "description": "Partial update."
          },
          "response": []
        },
        {
          "name": "Delete product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}",
            "description": "204 on success, 404 if not found."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Warm cache",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/admin/cache/warm",
            "description": "Runs configured cache warm. 501 until implemented."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Debug",
      "item": [
        {
          "name": "Get DB query count",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/debug/db-query-count",
            "description": "Returns `{ count }`."
          },
          "response": []
        },
        {
          "name": "Reset DB query count",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/debug/db-query-count/reset",
            "description": "Returns `{ ok: true }`."
          },
          "response": []
        }
      ]
    }
  ]
}
