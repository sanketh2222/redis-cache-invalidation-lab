{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Redis Cache Invalidation Lab API",
    "description": "Product catalog API with Redis caching (**redis-cache-invalidation-lab**).\n\n**Default:** `baseUrl` = http://localhost:3000\n\n**Dual instances:** change collection variable `baseUrl` to http://localhost:3001 (API 2) or http://localhost:8080 (Docker LB).\n\nEndpoints match README.md API table.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "category",
      "value": "electronics",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & Metrics",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Liveness check. Returns `{ ok, instance }` (INSTANCE_ID when running dual API)."
          },
          "response": []
        },
        {
          "name": "Metrics (Prometheus)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/metrics",
            "description": "Prometheus text exposition: cache hits/misses, hit ratio, Redis memory, etc."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products",
            "description": "Full product list. Cached under Redis key `products:list` when implemented."
          },
          "response": []
        },
        {
          "name": "List products by category",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products?category={{category}}",
            "description": "Category filter. Cached under `products:category:{category}` when implemented. Seed categories: electronics, home, stationery."
          },
          "response": []
        },
        {
          "name": "Get product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}",
            "description": "Product detail. Read-through cache key `product:{id}`."
          },
          "response": []
        },
        {
          "name": "Get product (missing ID)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/99999",
            "description": "404 for unknown id. Use for negative-cache practice (`product:missing:{id}`)."
          },
          "response": []
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"USB-C Hub\",\n  \"description\": \"4-port hub for practice\",\n  \"price\": 34.99,\n  \"category\": \"electronics\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/products",
            "description": "Requires `name`, `price`, and `category`. Returns 201 with created product."
          },
          "response": []
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse (updated)\",\n  \"price\": 31.99\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/products/{{productId}}",
            "description": "Partial update supported via repository. Should invalidate detail/list/category caches when implemented."
          },
          "response": []
        },
        {
          "name": "Delete product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}",
            "description": "204 on success, 404 if not found."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Warm cache",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/admin/cache/warm",
            "description": "Runs configured cache warm (`CACHE_WARM_PRODUCT_IDS`, `cacheWarmer.js`). 501 until implemented."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Debug",
      "item": [
        {
          "name": "Get DB query count",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/debug/db-query-count",
            "description": "Test helper: `{ count }` — DB queries since last reset on this instance."
          },
          "response": []
        },
        {
          "name": "Reset DB query count",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/debug/db-query-count/reset",
            "description": "Resets the in-process DB query counter. Returns `{ ok: true }`."
          },
          "response": []
        }
      ]
    }
  ]
}
