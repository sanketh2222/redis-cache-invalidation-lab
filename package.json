{
  "name": "redis-cache-invalidation-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Local simulation of Skillmeet cache-invalidation assessment",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --watch-path=./src src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "reset-fixtures": "node scripts/reset-fixtures.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "evaluate": "node scripts/evaluate.js",
    "load-test": "node scripts/load-test.js",
    "dev:api1": "cross-env PORT=3000 INSTANCE_ID=api-1 node --watch --watch-path=./src src/server.js",
    "dev:api2": "cross-env PORT=3001 INSTANCE_ID=api-2 node --watch --watch-path=./src src/server.js",
    "compose:dual": "docker compose --profile dual-api up -d"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
